* text=auto
*.rs text eol=lf
*.py text eol=lf
*.sh text eol=lf
# Embedded shell hooks must also work on remote Unix hosts.
src/terminal_shell/* text eol=lf
Dockerfile text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Preserve third-party grammars and notices byte for byte on every platform.
grammars/** -text whitespace=cr-at-eol,-blank-at-eof
themes/** -text whitespace=cr-at-eol,-blank-at-eof
tests/fixtures/waveform-viewer/third-party/** -text whitespace=cr-at-eol,-blank-at-eof

# Replay fixtures are verified with byte-level SHA-256.
tests/fixtures/completion-replay/** -text whitespace=cr-at-eol,-blank-at-eof
