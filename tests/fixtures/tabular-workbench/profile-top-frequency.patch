+#[test]
+fn profile_top_frequencies_match_full_sort_with_many_unique_values_and_ties() {
+    let mut source = String::from("value\n");
+    let mut expected = Vec::new();
+    for value in (0..45_000).rev() {
+        let text = format!("界{value:05}");
+        let count = value % 3 + 1;
+        for _ in 0..count {
+            source.push_str(&text);
+            source.push('\n');
+        }
+        expected.push((text, count));
+    }
+    let queried = query(csv(&source), Query::default(), vec![]);
+    let data = Arc::new(queried.data);
+    let order = Arc::new((0..data.table.rows.len()).collect());
+    let mut profile = ProfileJob::new(data, order, 0);
+    while !profile.step(127) {}
+    let result = profile.finish();
+    expected.sort_by(|a, b| b.1.cmp(&a.1).then_with(|| a.0.cmp(&b.0)));
+    expected.truncate(24);
+    assert_eq!(result.frequencies, expected);
+    assert_eq!(result.unique, 45_000);
+    assert_eq!(result.count, 90_000);
+    assert!(!result.limited);
+}
