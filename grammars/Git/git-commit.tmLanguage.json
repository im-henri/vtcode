{
	"information_for_contributors": [
		"Based on https://github.com/walles/git-commit-message-plus/blob/master/syntaxes/git-commit.tmLanguage.json",
		"via VS Code's git-base extension. VTCode extends it with subject, Conventional Commits, trailer,",
		"issue reference, commit hash and link highlighting."
	],
	"version": "https://github.com/walles/git-commit-message-plus/commit/35a079dea5a91b087021b40c01a6bb4eb0337a87",
	"name": "Git Commit Message",
	"scopeName": "text.git-commit",
	"patterns": [
		{
			"comment": "diff presented at the end of the commit message when using commit -v.",
			"name": "meta.embedded.diff.git-commit",
			"contentName": "source.diff",
			"begin": "(?=^diff\\ \\-\\-git)",
			"end": "\\z",
			"patterns": [
				{
					"include": "source.diff"
				}
			]
		},
		{
			"comment": "User supplied message",
			"name": "meta.scope.message.git-commit",
			"begin": "^(?!#)",
			"end": "^(?=#)",
			"patterns": [
				{
					"include": "#subject"
				},
				{
					"include": "#body"
				}
			]
		},
		{
			"comment": "Git supplied metadata in a number of lines starting with #",
			"name": "meta.scope.metadata.git-commit",
			"begin": "^(?=#)",
			"contentName": "comment.line.number-sign.git-commit",
			"end": "^(?!#)",
			"patterns": [
				{
					"match": "^#\\t((modified|renamed):.*)$",
					"captures": {
						"1": {
							"name": "markup.changed.git-commit"
						}
					}
				},
				{
					"match": "^#\\t(new file:.*)$",
					"captures": {
						"1": {
							"name": "markup.inserted.git-commit"
						}
					}
				},
				{
					"match": "^#\\t(deleted.*)$",
					"captures": {
						"1": {
							"name": "markup.deleted.git-commit"
						}
					}
				},
				{
					"comment": "Fallback for non-English git commit template",
					"match": "^#\\t([^:]+): *(.*)$",
					"captures": {
						"1": {
							"name": "keyword.other.file-type.git-commit"
						},
						"2": {
							"name": "string.unquoted.filename.git-commit"
						}
					}
				}
			]
		}
	],
	"repository": {
		"url": {
			"match": "\\b(?:https?|ftp|ssh|git)://[^\\s<>()\\[\\]]+[^\\s<>()\\[\\].,;:!?'\\\"]",
			"name": "markup.underline.link.git-commit"
		},
		"email": {
			"match": "(<)([^<>\\s@]+@[^<>\\s]+)(>)",
			"captures": {
				"1": {
					"name": "punctuation.definition.email.begin.git-commit"
				},
				"2": {
					"name": "markup.underline.link.email.git-commit"
				},
				"3": {
					"name": "punctuation.definition.email.end.git-commit"
				}
			}
		},
		"issue": {
			"match": "(?<![\\w&/#])(?:[\\w.-]+/[\\w.-]+)?(?:#|GH-|!)\\d+\\b",
			"name": "constant.other.reference.issue.git-commit"
		},
		"hash": {
			"match": "(?<![\\w/.-])(?=[0-9a-f]*[a-f])(?=[0-9a-f]*\\d)[0-9a-f]{7,64}\\b(?![\\w-])",
			"name": "constant.sha.git-commit"
		},
		"code": {
			"match": "(`)([^`\\n]+)(`)",
			"name": "markup.inline.raw.git-commit",
			"captures": {
				"1": {
					"name": "punctuation.definition.raw.git-commit"
				},
				"3": {
					"name": "punctuation.definition.raw.git-commit"
				}
			}
		},
		"conventional": {
			"comment": "Conventional Commits prefix: type(scope)!: description",
			"match": "\\G([A-Za-z]+)(?:(\\()([^()\\n]*)(\\)))?(!)?(:)(?=\\s)",
			"captures": {
				"1": {
					"name": "keyword.other.type.git-commit"
				},
				"2": {
					"name": "punctuation.definition.scope.begin.git-commit"
				},
				"3": {
					"name": "entity.name.section.scope.git-commit"
				},
				"4": {
					"name": "punctuation.definition.scope.end.git-commit"
				},
				"5": {
					"name": "keyword.operator.breaking-change.git-commit"
				},
				"6": {
					"name": "punctuation.separator.git-commit"
				}
			}
		},
		"subject": {
			"comment": "The first line is the subject. Mark > 50 characters as deprecated, > 72 as illegal",
			"name": "meta.scope.subject.git-commit markup.heading.subject.git-commit",
			"begin": "\\G(?=.)",
			"end": "$",
			"patterns": [
				{
					"include": "#conventional"
				},
				{
					"match": "(?<=^.{72}).+",
					"name": "invalid.illegal.line-too-long.git-commit"
				},
				{
					"match": "(?<=^.{50}).{1,22}",
					"name": "invalid.deprecated.line-too-long.git-commit"
				},
				{
					"include": "#issue"
				},
				{
					"include": "#code"
				}
			]
		},
		"trailer": {
			"match": "^([A-Z][A-Za-z0-9]*(?:-[A-Za-z0-9]+)+|Fixes|Closes|Resolves|Refs|Ref|Bug|Issue|Cc|Link)(:)[ \\t]+(.*)$",
			"name": "meta.trailer.git-commit",
			"captures": {
				"1": {
					"name": "keyword.other.trailer.git-commit"
				},
				"2": {
					"name": "punctuation.separator.key-value.git-commit"
				},
				"3": {
					"name": "string.unquoted.trailer.git-commit",
					"patterns": [
						{
							"include": "#email"
						},
						{
							"include": "#issue"
						},
						{
							"include": "#url"
						},
						{
							"include": "#hash"
						}
					]
				}
			}
		},
		"list": {
			"match": "^\\s*([-*+]|\\d+[.)])(?=\\s)",
			"captures": {
				"1": {
					"name": "punctuation.definition.list.begin.git-commit"
				}
			}
		},
		"body": {
			"patterns": [
				{
					"include": "#trailer"
				},
				{
					"include": "#list"
				},
				{
					"include": "#url"
				},
				{
					"include": "#email"
				},
				{
					"include": "#issue"
				},
				{
					"include": "#hash"
				},
				{
					"include": "#code"
				}
			]
		}
	}
}
